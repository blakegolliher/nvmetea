# nvmetea-exporter settings.
# Address and port of /metrics and /healthz. Keep it on loopback unless the
# network path to it is trusted: the metrics describe the host's storage
# topology, addresses and performance.
NVMETEA_LISTEN=127.0.0.1:9469
# Extra `nvmetea serve` options, e.g. "--interval 10 --prom-max-queues 64" or
# "--no-bpf" (passive data only).
NVMETEA_ARGS=
